{{- $h := trimSuffix ".local" .chezmoi.hostname -}}
{{- $hostStyle := "cyan" -}}
{{- if or (eq $h "Mac-mini") (eq $h "M5") -}}
  {{- $hostStyle = "green" -}}
{{- else if or (hasPrefix "skynet-cp-" $h) (hasPrefix "skynet-wrk-" $h) -}}
  {{- $hostStyle = "red" -}}
{{- else if or (hasPrefix "devpod-" $h) (eq $h "ubuntu-server-1") (eq $h "ubuntu-desktop-1") -}}
  {{- $hostStyle = "yellow" -}}
{{- else if env "SSH_CONNECTION" -}}
  {{- $hostStyle = "magenta" -}}
{{- end -}}
# Get editor completions based on the config schema
"$schema" = 'https://starship.rs/config-schema.json'

# Inserts a blank line between shell prompts
add_newline = true

# Replace the '❯' symbol in the prompt with '➜'
[character] # The name of the module we are configuring is 'character'
success_symbol = '[➜](bold green)' # The 'success_symbol' segment is being set to '➜' with the color 'bold green'

# Disable the package module, hiding it from the prompt completely
[package]
disabled = true

# Colour the hostname by machine so SSH sessions are visually distinct.
# Style is filled in by chezmoi from this machine's hostname.
[hostname]
ssh_only = false
style = "bold {{ $hostStyle }}"
