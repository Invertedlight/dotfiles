# zprofile - for login

# Homebrew: only if installed (macOS /opt/homebrew or /usr/local, Linux /home/linuxbrew)
[ -r "$HOME/.config/shell/brew-env.sh" ] && . "$HOME/.config/shell/brew-env.sh"
alias cat="bat"

# Setup arrow keys for left right option moving forward back works
bindkey '^[[1;3D' backward-word 
bindkey '^[[1;3C' forward-word

# ssh-agent: reuse a reachable/forwarded agent or start exactly one on a fixed
# socket (never stacks). On macOS the launchd agent is still avoided.
[ -r "$HOME/.config/shell/ssh-agent.sh" ] && . "$HOME/.config/shell/ssh-agent.sh"

# Load keys into this agent only if missing (only keys that exist on this machine)
if [ -n "$SSH_AUTH_SOCK" ]; then
  if [ -f ~/.ssh/id_ed25519_sk_github ] && ! ssh-add -l 2>/dev/null | grep -qF "id_ed25519_sk_github"; then
    ssh-add ~/.ssh/id_ed25519_sk_github 2>/dev/null
  fi
  if [ -f ~/.ssh/id_ed25519_sk_github_backup ] && ! ssh-add -l 2>/dev/null | grep -qF "id_ed25519_sk_github_backup"; then
    ssh-add ~/.ssh/id_ed25519_sk_github_backup 2>/dev/null
  fi
fi

# mise: put tool shims on PATH for login shells, including non-interactive ones.
# Interactive shells also run `mise activate zsh` from .zshrc.
export PATH="$HOME/.local/bin:$PATH"
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh --shims)"
